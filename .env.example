# ===== Telegram =====
# Bot Token，由 @BotFather 创建机器人后获取
TG_BOT_TOKEN=123456:ABC-DEF1234ghIkl-zyx57W2v1u123ew11

# 允许使用的 Telegram 会话 chat_id（逗号分隔，建议填你的私人会话 ID）
# 获取方式：给机器人发任意消息后，查看本程序日志中的会话号，或用 @userinfobot
# 多用户模式（配置了 users.json）时可以不填，白名单自动取 users.json 里的 chat_ids
# 注意：单用户 .env 模式必须配置本项，否则启动会报错（防止任何人使用你的 Bot）
TG_ALLOWED_IDS=123456789

# Telegram API 地址。大陆网络需代理或镜像时改这里，例如 https://tg-bot-api.example.com
TG_API_BASE=https://api.telegram.org

# 命令菜单自动刷新的间隔（分钟），只有菜单内容变化才会调用 Telegram 接口；/menu 或 /info 可立即刷新
# TG_MENU_REFRESH_MINUTES=30

# ===== 用户配置 =====
# 多用户模式：按 chat_id 绑定各自的 LitePan 实例与「盘名 -> 事件」映射，见 users.example.json。
# 复制为 users.json 并编辑后，下面的 LITEPAN_* 可以留空。
# 单用户模式：不配置 users.json 时，用下面的 LITEPAN_* 环境变量。
USERS_FILE=users.json

# ===== LitePan =====
# 单用户模式才需要填（容器内用服务名，如 http://litepan:5211）
LITEPAN_URL=

# LitePan 后台创建的「任务执行」类型 API Key（真实 Key 以 lpk_api_ 开头）
LITEPAN_API_KEY=

# 兜底事件：未配置管理员账号时 /refresh 用它触发（与后台 Webhook 事件名一致）
# 旧配置名 LITEPAN_EVENT 仍然兼容，优先读新名
LITEPAN_FALLBACK_EVENT=tg_refresh
LITEPAN_SOURCE=telegram
LITEPAN_DEFAULT_PATH=/

# 隐私：回复中默认不显示 LitePan 地址；调试时置 1 可显示（盘名/规则名/任务名始终显示）
# SHOW_LITEPAN_URL=0

# 可选（配置了管理员账号后一般不需要）：盘名 -> 事件 映射，让 /refresh 光鸭-A 直接触发对应规则。
# 逗号分隔的「别名:事件名」，或 JSON 对象两种格式都支持：
# DRIVES=光鸭-A:quarkA_refresh,123-A:123A_refresh
# DRIVES={"光鸭-A":"quarkA_refresh","123-A":"123A_refresh"}
# DRIVES=

# 可选：请求体额外附带 message 字段（LitePan 会忽略该字段，仅留痕用，默认不发送）
# LITEPAN_MESSAGE=download_completed，请执行联动

# ===== 回执模式（可选）=====
# 配置后，Bot 会用管理员账号登录 LitePan 轮询任务状态，触发后推送完成/失败回执。
# 多用户模式请在 users.json 里按用户配置 admin_user/admin_password。
# 同时自动开启「自动发现」：/info 直接读取 LitePan 的账号名、规则名、事件名，
# /refresh 光鸭-A 直接用 LitePan 里的账号名，无需手工维护 DRIVES 映射。
# 不配置则只推送「已触发」，不推送最终结果。
LITEPAN_ADMIN_USER=
LITEPAN_ADMIN_PASSWORD=
